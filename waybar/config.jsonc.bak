{
"layer": "top",
"position": "top",
"height": 30,
"margin-top": 6,
"margin-left": 10,
"margin-right": 10,
"spacing": 6,
"modules-left": ["hyprland/workspaces", "custom/term", "idle_inhibitor", "custom/files", "battery", "temperature", "memory"],
"modules-center": ["custom/notification", "clock", "custom/lock"],
"modules-right": ["network", "pulseaudio", "pulseaudio#mic", "keyboard-state", "custom/power"],
"hyprland/workplaces": {"format": "{id}", "on-click": "activate"},
"custom/term": {"format": "\uf120", "on-click": "foot"},
"custom/files": {"format": "\uf07b", "on-click": "thunar"},
"idle_inhibitor": {"format": "{icon}", "format-icons": {"activated": "\uf06e", "deactivated": "\uf070"}},
"battery": {"bat": "BAT0", "format": "{icon} {capacity}%", "format-charging": "\uf0e7 {capacity}%", "format-icons": ["\uf244", "\uf242", "\uf241", "\uf240"]},
"temperature": {"critical-threshold": 80, "format": "\uf2c9 {temperatureC}\u00b0c"},
"memory": {"interval": 5, "format": "\uf2db {used:0.1f}G"},
"custom/notification": {"return-type": "json", "exec": "swaync-client -swb", "on-click": "swaync-client -t -sw", "format": "{icon} {text}", "format-icons": {"notification": "\uf0f3", "none": "\uf0f3", "dnd-notification": "\uf1f6", "dnd-none": "\uf1f6"}, "escape": true},
"clock": {"format": "{:%I:%M %p}", "tooltip-format": "{:%A, %d %B %Y}"},
"custom/lock": {"format": "\uf023", "on-click": "hyprlock"},
"network": {"on-click": "~/.config/waybar/wifi-menu.sh", "interval": 2, "format-wifi": "\uf1eb {bandwidthUpBytes} \u2191 {bandwidthDownBytes} \u2193", "format-disconnected": "\uf1eb off"},
"pulseaudio": {"format": "{icon} {volume}%", "format-muted": "\uf026 mute", "format-icons": {"default": ["\uf027", "\uf028"]}, "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"},
"pulseaudio#mic": {"format": "{format_source}", "format-source": "\uf130 {volume}%", "format-source-muted": "\uf131 mute", "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"},
"keyboard-state": {"capslock": true, "format": "\uf11c {icon}", "format-icons": {"locked": "\uf023", "unlocked": "\uf09c"}},
"custom/power": {"format": "\uf011", "on-click": "/home/Moses/.local/bin/powermenu"}
}
