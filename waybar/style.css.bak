* {
font-family: "JetBrainsMono Nerd Font";
font-size: 13px;
border: none;
min-height: 0;
}
window#waybar {
background: transparent;
color: #e6e6ff;
}
#custom-term, #idle_inhibitor, #custom-files, #battery, #temperature, #memory, #custom-cava, #custom-notification, #clock, #custom-lock, #network, #pulseaudio, #keyboard-state, #custom-power {
background: rgba(22, 22, 35, 0.65);
border-radius: 14px;
padding: 2px 10px;
margin: 0 2px;
}
#battery.warning {
color: #f5c542;
}
#battery.critical, #temperature.critical, #custom-lock, #network.disconnected {
color: #ff5f6d;
}
#custom-power {
margin-right: 14px;
}
