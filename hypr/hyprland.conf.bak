monitor=,preferred,auto,1

$mainMod = SUPER
exec-once = hyprlock
exec-once = dbus-update-activation-environment --all
exec-once = systemctl --user stop xdg-desktop-portal-hyprland.sevice xdg-desktop-portal.service
exec-once = systemctl --user start xdg-desktop-portal-hyprland.service xdg-desktop-portal.service
exec-once = systemctl --user start xdg-desktop-portal-hyprland
exec-once = waybar
exec-once = waybar -c ~/.config/waybar/pill.jsonc -s ~/.config/waybar/pill.css
exec-once = ~/.config/hypr/btconnect.sh
exec-once = swaync
#exec-once = hypridle
exec-once = swayosd-server
#exec-once = hyprpaper
exec-once = dunst
exec-once = mpvpaper -o "no-audio loop" '*' /home/Moses/Downloads/wallpaper.mp4
exec-once = python ~/.config/hypr/volosd.py
exec-once = python -W ignore ~/.config/hypr/volosd.py
exec-once = /usr/lib/polkit-kde-authentication-agent-1

input {
    kb_layout = us
    follow_mouse = 1
}

general {
     gaps_in = 5
     gaps_out = 10
     border_size = 2
     col.active_border = rgba(33ccffee)
     col.inactive_border = rgba(595959aa)
}

decoration {
     rounding = 10
     active_opacity = 0.92
     inactive_opacity = 0.82
     blur {
         enabled = true
         size = 5
         passes = 3
     }
     shadow {
         enabled = true
         range = 12
         render_power = 3
     }
}

window = float on, center on, size 900 550, match:class ^(foot-foot)$
bind = SUPER SHIFT, Return, exec, foot --app-id foot-float
bind = SUPER, Return, exec, foot
bind = SUPER, Q, killactive
bind = SUPER, E, exec, pcmanfm
bind = SUPER, F, exec, code
bind = SUPER, R, exec, ~/.config/wofi/launch.sh
bind = SUPER, V, togglefloating
bind = SUPER, L, exec, hyprlock
bind = SUPER SHIFT, C, exec, foot -e tty-clock -c -s -t -C 5 
bind = SUPER SHIFT, A, exec, foot -e cava
bind = SUPER, Escape, exec, wlogout -b 6 -c 0 -r 0 -L 200 -R 200 -T 200 -B 200
bind = SUPER, C, exec, claude-desktop-hardened

bind = SUPER, 1, workspace, 1
bind = SUPER, 2, workspace, 2
bind = SUPER, 3, workspace, 3
bind = SUPER SHIFT, 1, movetoworkspace, 1
bind = SUPER SHIFT, 2, movetoworkspace, 2
bind = SUPER SHIFT, 3, movetoworkspace, 3
bind = , Print, exec, grim ~/Pictures/$(date +%Y%m%d-%H%M%S).png
bind = SHIFT, Print, exec, grim -g "$(slurp)" ~/Pictures/$(date +%Y%m%d-%H%M%S).png
bind = CTRL, Print, exec, grim -g "$(slurp)" - | wl-copy
bindel = , XF86AudioRaiseVolume, exec, ~/.config/hypr/vol.sh up
bindel = , XF86AudioLowerVolume, exec, ~/.config/hypr/vol.sh down
bindl = , XF86AudioMute, exec, ~/.config/hypr/vol.sh mute
bindel = , XF86MonBrightnessUp, exec, ~/.config/hypr/bri.sh up
bindel = , XF86MonBrightnessDown, exec, ~/.config/hypr/bri.sh down
windowrule = float on, center on, size 900 520, match:class ^foot-float$
