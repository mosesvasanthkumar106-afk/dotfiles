general {
    disable_loading_bar = true
    grace = 2
    hide_cursor = true
    no_fade_in = false
}

background {
    monitor =
    path = /home/Moses/Downloads/lockscreen.jpg
    blur_passes = 0
    blur_size = 0
    noise = 0.0117
    contrast = 0
    brightness = 0.8
    vibrancy = 0.2
}

# Big clock
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%-I:%M")"
    color = rgba(255, 255, 255, 1.0)
    shadow_passes = 1
    shadow_size = 3
    shadow_color = rgba(0, 0, 0, 0.4)
    shadow_boost = 1.2
    font_size = 90
    font_family = JetBrainsMono Nerd Font
    position = 0, 250
    halign = center
    valign = center
}

# Date under the clock
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%A, %B %d")"
    color = rgba(255, 255, 255, 1.0)
    font_size = 30
    font_family = JetBrainsMono Nerd Font
    position = 0, 280
    halign = center
    valign = center
}

# Password input box
input-field {
    monitor =
    size = 300, 60
    outline_thickness = 6
    dots_size = 0.26
    dots_spacing = 0.3
    dots_center = true
    outer_color = rgba(255, 255, 255, 0.3)
    inner_color = rgba(0, 0, 0, 0.5)
    font_color = rgba(230, 230, 230)
    fade_on_empty = true
    placeholder_text = <i>Password...</i>
    hide_input = false
    position = 0, -20
    halign = center
    valign = center
}
