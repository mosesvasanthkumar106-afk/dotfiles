#window {
  background-color: transparent;
  border: none;
}
#outer-box {
  background-color: transparent;
  margin: 0;
  padding: 0;
}
#scroll {
  margin: 0;
}
#input {
  background-color: rgba(30, 30, 30, 0.55);
  color: #ffffff;
  border: 2px solid rgba(255, 255, 255, 0.7);
  border-radius: 30px;
  padding: 10px 22px;
  font-size: 16px;
  box-shadow: none;
}
#input:focus {
  border: 2px solid rgba(255, 255, 255, 0.95);
  box-shadow: none;
}
